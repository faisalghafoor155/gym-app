# Production Environment Variables
# Copy to .env and fill in your values

# Database
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=gym_app

# Auth & Security
JWT_SECRET=your_very_long_secret_key_at_least_32_characters_long

# The domain the certificate is issued for, used by docker-compose.https.yml
# for both nginx and the certbot renewal. Bare hostname, no scheme, no slash.
DOMAIN=yourdomain.com

# HTTPS only *marks* the session cookie Secure — it does not provide TLS. The
# https overlay sets both of these for you; they are here for a deployment that
# terminates TLS somewhere else (a load balancer, a managed proxy).
HTTPS=true
APP_URL=https://yourdomain.com

# Encrypts fingerprint templates before they reach the database. The server
# REFUSES TO START without a valid 32-byte base64 key. Generate one with:
#   openssl rand -base64 32
# Losing it means re-enrolling every member at the desk, so keep a copy
# somewhere that is not the database backup.
BIOMETRIC_KEY=generate_with_openssl_rand_base64_32

# How many proxies sit in front of the API. 1 = the nginx container alone,
# which is the docker-compose setup. Raise to 2 if a CDN or tunnel terminates
# TLS ahead of nginx. Too low and every client shares one rate-limit budget, so
# a single attacker locks out every user; too high and a client can spoof its
# IP through X-Forwarded-For.
TRUST_PROXY_HOPS=1

# Email (choose one: Resend API or SMTP)
# Resend API (recommended)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=noreply@yourdomain.com

# OR SMTP (Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@yourdomain.com

# Google OAuth (for sign-in button)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# AWS S3 (for member photos)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=gym-app-photos

# Subscription billing — what gyms pay YOU.
# Your own merchant account, not a gym's: one set of credentials for both would
# let a gym settle its own invoice against its own account. Unset, invoices are
# still issued and unpaid gyms are still suspended, but each invoice has to be
# settled by hand with `npm run billing <invoiceId> paid`.
PLATFORM_JAZZCASH_MERCHANT_ID=MC12345
PLATFORM_JAZZCASH_PASSWORD=your_jazzcash_password
PLATFORM_JAZZCASH_INTEGRITY_SALT=your_integrity_salt
PLATFORM_EASYPAISA_STORE_ID=12345
PLATFORM_EASYPAISA_HASH_KEY=your_hash_key
# What each tier costs per period, in rupees.
PLAN_PRICE_BASIC=3000
PLAN_PRICE_PRO=8000

# Backups
# Encrypts every nightly dump. A dump is a plaintext copy of every member's
# name, phone, address and payment history, and it leaves this machine — to a
# laptop, a USB stick, an object store. Generate with:
#   openssl rand -base64 32
# NOT the same key as BIOMETRIC_KEY, and never stored beside the backups: a key
# next to the thing it encrypts protects nobody.
BACKUP_ENCRYPTION_KEY=generate_a_different_key_the_same_way

# Offsite copy. Any S3-compatible store — AWS, Backblaze B2, Cloudflare R2,
# Wasabi. Without this the dumps sit on the same disk as the database they
# exist to protect, which is not a backup.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=

# Optional
# Only needed when the frontend is served from a different origin than the API.
# With the docker stack nginx serves both, so requests are same-origin and this
# stays empty — setting it to the app's own URL is harmless but pointless.
CORS_ORIGIN=
BACKUP_KEEP_DAYS=30
TZ=Asia/Karachi
REMINDER_CRON=0 9 * * *
