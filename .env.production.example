# Production Environment Variables
# Copy to .env and fill in your values

# Database
POSTGRES_USER=gym_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=gym_app

# Auth & Security
JWT_SECRET=your_very_long_secret_key_at_least_32_characters_long
HTTPS=true
APP_URL=https://yourdomain.com

# Email (choose one: Resend API or SMTP)
# Resend API (recommended)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=noreply@yourdomain.com

# OR SMTP (Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@yourdomain.com

# Google OAuth (for sign-in button)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# AWS S3 (for member photos)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=gym-app-photos

# Subscription billing — what gyms pay YOU.
# Your own merchant account, not a gym's: one set of credentials for both would
# let a gym settle its own invoice against its own account. Unset, invoices are
# still issued and unpaid gyms are still suspended, but each invoice has to be
# settled by hand with `npm run billing <invoiceId> paid`.
PLATFORM_JAZZCASH_MERCHANT_ID=MC12345
PLATFORM_JAZZCASH_PASSWORD=your_jazzcash_password
PLATFORM_JAZZCASH_INTEGRITY_SALT=your_integrity_salt
PLATFORM_EASYPAISA_STORE_ID=12345
PLATFORM_EASYPAISA_HASH_KEY=your_hash_key
# What each tier costs per period, in rupees.
PLAN_PRICE_BASIC=3000
PLAN_PRICE_PRO=8000

# Optional
CORS_ORIGIN=https://yourdomain.com
BACKUP_KEEP_DAYS=30
TZ=Asia/Karachi
REMINDER_CRON=0 9 * * *
