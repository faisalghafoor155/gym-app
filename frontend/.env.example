# Copy to .env for local development. Never commit .env.

# Google sign-in (optional). Without it the Google button is hidden.
# Create an OAuth 2.0 Web client at:
#   https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_CLIENT_ID=

# Subscriptions (plan step on Register, Plan & Usage page). Off unless "true".
# Keep in step with SUBSCRIPTIONS_ENABLED in backend/.env.
# VITE_SUBSCRIPTIONS_ENABLED=true
